<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 查询其他应用的权限 - Android 11+ (API 30+) 用于调用微信扫码 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="weixin" />
        </intent>
        <package android:name="com.tencent.mm" />
    </queries>

    <!-- 基础网络权限 - 用于远程推理API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 应用内更新：安装下载的 APK（方案2） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- 存储权限 - Android 12 及以下版本 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
                     android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
                     android:maxSdkVersion="32" />
    
    <!-- 媒体权限 - Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.WRITE_MEDIA_IMAGES" />
    
    <!-- 管理所有文件权限 - Android 11+ (API 30+) 用于删除其他应用创建的文件 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    
    <!-- 访问媒体位置信息权限 - Android 10+ (API 29+) 用于读取照片EXIF中的GPS信息 -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    
    <!-- 唤醒锁权限 - 防止手机休眠时影响图片处理性能 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 前台服务权限 - Android 9+ (API 28+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    
    <!-- 通知权限 - Android 13+ (API 33+) 用于前台服务显示通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher"
      android:allowBackup="false"
      android:usesCleartextTraffic="true"
      android:networkSecurityConfig="@xml/network_security_config"
      android:requestLegacyExternalStorage="true"
      android:preserveLegacyExternalStorage="true"
      android:theme="@style/AppTheme"
      android:supportsRtl="true">
      
      <!-- FileProvider配置 - 用于分享文件 -->
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.fileprovider"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/file_paths" />
      </provider>
      
      <!-- 前台服务 - 用于后台扫描 -->
      <service
        android:name=".ScanForegroundService"
        android:enabled="true"
        android:exported="false"
        android:foregroundServiceType="dataSync"
        android:stopWithTask="false" />  <!-- 🔥 新增：应用关闭时不停止服务 -->
      
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true"
        android:keepScreenOn="false"
        android:theme="@style/AppTheme.NoActionBar">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
    </application>
</manifest>

