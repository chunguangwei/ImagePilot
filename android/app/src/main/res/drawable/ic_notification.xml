<!--
  ImagePilot 通知状态栏图标 —— Vector drawable，Android Material 标准做法。

  设计：相框 + 山景 + 太阳剪影。语义即"照片/图像应用"，与 ic_launcher 的玻璃文件夹
  品牌一致但更适合 24dp 小尺寸阅读。

  Android 5.0+ 通知图标必须是「单色（白色）+ alpha mask」，系统会按通知通道色 tint。
  全部 fillColor 设为 #FFFFFF；不同元素靠 fillAlpha 区分层次（外框 0.4、相框边 1.0、
  山+太阳 1.0），最终呈现一个低对比的剪影。

  Vector drawable 自动适配所有屏幕密度（mdpi/hdpi/xhdpi/xxhdpi/xxxhdpi），不需要
  五套 PNG。XML 单文件 < 1KB，比之前的 96x96 PNG（292B）质量提升 + 全密度覆盖。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 相框外框（evenOdd 镂空成边线） -->
    <path
        android:fillType="evenOdd"
        android:pathData="M3,5 L21,5 A1,1 0 0 1 22,6 L22,18 A1,1 0 0 1 21,19 L3,19 A1,1 0 0 1 2,18 L2,6 A1,1 0 0 1 3,5 Z M4,7 L4,17 L20,17 L20,7 L4,7 Z"
        android:fillColor="#FFFFFF" />

    <!-- 远山 + 近山 -->
    <path
        android:pathData="M4,17 L9,11 L12,14 L15,10 L20,17 Z"
        android:fillColor="#FFFFFF" />

    <!-- 太阳 -->
    <path
        android:pathData="M16,9 m-1.3,0 a1.3,1.3 0 1,0 2.6,0 a1.3,1.3 0 1,0 -2.6,0"
        android:fillColor="#FFFFFF" />
</vector>
