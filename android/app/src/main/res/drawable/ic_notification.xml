<!--
  ImagePilot 通知状态栏图标 —— 罗盘剪影（与 App 图标/启动屏同源）。

  Android 5.0+ 通知小图标必须是「单色(白)+alpha mask」，系统按通道色 tint。
  这里用白色罗盘：分段外环 + 四角星 + 中心点，24dp 小尺寸下清晰可读。
  Vector drawable 自动适配全密度，单文件。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 外环（evenOdd 镂空成圆环） -->
    <path
        android:fillType="evenOdd"
        android:fillColor="#FFFFFF"
        android:pathData="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 Z M12,4.2 A7.8,7.8 0 1 1 12,19.8 A7.8,7.8 0 1 1 12,4.2 Z" />

    <!-- 四角星（罗盘指针） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,5.5 L13.3,10.7 L18.5,12 L13.3,13.3 L12,18.5 L10.7,13.3 L5.5,12 L10.7,10.7 Z" />

    <!-- 中心轴点 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,12 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0" />
</vector>
