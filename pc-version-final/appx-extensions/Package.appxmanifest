<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         IgnorableNamespaces="uap uap3">
  <Identity Name="E8546D00.75903E98454E"
            Version="1.1.3.0"
            Publisher="CN=03F46D22-3B0F-4788-A8BF-351A4DF78D3D"/>
  <Properties>
    <DisplayName>ImagePilot</DisplayName>
    <PublisherDisplayName>智语未来软件</PublisherDisplayName>
    <Description>ImagePilot-智能分类，便捷管理，仅你可见</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="zh-CN"/>
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0"/>
  </Dependencies>
  <Applications>
    <Application Id="ImagePilot"
                 Executable="ImagePilot.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="ImagePilot"
